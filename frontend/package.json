{
  "name": "nextvwt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "npx playwright test",
    "test:e2e:playwright": "npx playwright test",
    "android:build": "npm run build && npx cap sync && cmd /c \"cd android && gradlew.bat assembleDebug\"",
    "check": "npm run lint && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "test:e2e:chrome": "playwright test --project=chrome-installed",
    "test:e2e:edge": "playwright test --project=msedge-installed",
    "test:e2e:system-browser": "node scripts/run-playwright-with-system-browser.mjs",
    "install:pnpm": "pnpm install --no-frozen-lockfile",
    "check:windows": "npm run lint && npm run build && npm audit --omit=dev && npm run test:e2e:system-browser",
    "dev:clean": "node scripts/clean-vite-cache.mjs && pnpm dev",
    "clean:vite": "node scripts/clean-vite-cache.mjs",
    "start:prod": "node dist/server.cjs",
    "serve:prod": "pnpm run build && pnpm start"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "dseg": "^0.46.0",
    "express": "^4.21.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.546.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "vite": "6.4.2",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/mime": "^4.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^5.4.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  },
  "packageManager": "pnpm@10.20.0"
}
