# Server
PORT=3000
NODE_ENV=development

# Production: isi dengan domain resmi, dipisahkan koma.
# Contoh: ALLOWED_ORIGINS=https://nextvwt.example.com,https://www.nextvwt.example.com
ALLOWED_ORIGINS=

# Opsional: aktifkan PIN global untuk join channel. Kosongkan untuk mode publik/prototipe.
CHANNEL_JOIN_SECRET=

# Batas user per channel untuk menghindari overload WebRTC mesh.
MAX_CHANNEL_USERS=10

# WebRTC ICE. TURN sangat direkomendasikan untuk jaringan mobile/NAT ketat.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# GEMINI_API_KEY: hanya isi jika fitur AI dipakai.
GEMINI_API_KEY=

# APP_URL: URL publik aplikasi saat deploy.
APP_URL=
